# ====================================================================
# Copy to `.env` and fill in. Only GROQ_API_KEY is actually required.
# Get a key at https://console.groq.com/keys
# ====================================================================

GROQ_API_KEY=gsk_replace_me

# --- transcription ---------------------------------------------------
# groq           hosted Whisper large-v3-turbo. ~$0.04/audio-hour, ~200x
#                real-time. Default, and what the live API uses.
# faster_whisper open-weights Whisper on YOUR machine. Free, no network,
#                but slow without a GPU. pip install faster-whisper first.
# mock           fake transcript, no key needed. For testing the plumbing.
ASR_BACKEND=groq
ASR_MODEL_GROQ=whisper-large-v3-turbo
ASR_LANGUAGE=en

# Domain vocabulary given to Whisper as a decoding hint. EDIT THIS to name the
# actual bank and the kinds of calls in your data - on 8 kHz telephone audio it
# is the difference between "Harper Valley" and "Papa Valley". Keep it short;
# Whisper treats it as a style/vocabulary prime, not an instruction.
ASR_PROMPT=Harper Valley National Bank. Customer service call about appointments, transfers, balances, and card services.

# --- analysis --------------------------------------------------------
# groq | mock
LLM_BACKEND=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2

# --- audio -----------------------------------------------------------
# The brief says left=agent, right=customer. Run scripts/preflight.py to
# confirm on real files; flip these if it disagrees.
LEFT_CHANNEL_SPEAKER=agent
RIGHT_CHANNEL_SPEAKER=customer

# --- mood timeline ---------------------------------------------------
# turn   = one point per customer turn (best for these ~50s calls)
# minute = integer minute buckets (matches the original mock data)
MOOD_TIMELINE_MODE=turn

# --- paths -----------------------------------------------------------
DB_PATH=data/callradar.db
AUDIO_DIR=data/audio
METADATA_DIR=data/metadata

# --- batch -----------------------------------------------------------
BATCH_WORKERS=4
